{
  "name": "projectlog-desktop",
  "version": "1.6.0",
  "description": "ProjectLog 1.6.0 - A faster, responsive desktop project journal with Pogo local AI",
  "author": {
    "name": "Shakib Hossain Tahmid"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.shakib.projectlog",
    "productName": "ProjectLog",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "package.json",
      "assets/**/*",
      "update.html"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ProjectLog"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sakib-12345",
        "repo": "ProjectLog",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
